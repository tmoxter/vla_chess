# DSRL on the round 1 DAgger policy (step 10000): a SAC agent steers the frozen policy's initial
# noise on d7->d6, with every episode starting from the pawn jittered up to 3 mm off its square's
# centre. Launched with:
#   ENV_FILE=runpod/dsrl_v1.env ./runpod/bootstrap.sh <ssh_host> <ssh_port>
# Uploads the checkpoint from this machine and runs runpod/dsrl.sh in the pod's `train` tmux
# session; its log is ${OUT_DIR}/dsrl.log. Nothing is pulled from or pushed to the Hub but the
# SmolVLA backbone.
#
# The frozen policy's d7->d6 placement on centred starts is 23.4% over 1000 rollouts; the run's
# own baseline evaluation measures it on the jittered starts the agent is scored on.
LAUNCH=dsrl
SYNC_REPO=1
POD_REPO=/workspace/vla_chess
HUB_PUSH=false
POLICY_LOCAL=${HOME}/data/vla_chess/dagger_v3/round1/train/checkpoints/010000/pretrained_model
POLICY_IN=/workspace/policies/smolvla_chess_dagger_v3_r1_010000
OUT_DIR=/workspace/dsrl/v1
SOURCE=d7
TARGET=d6
N_ACTION_STEPS=10
PIECE_JITTER_MM=3
STEERED_STEPS=10
STEER=replace
MAGNITUDE=1.5
FILL=zero
SUCCESS=placed
WARMUP_EPISODES=20
TRAIN_EPISODES=1000
EVAL_EVERY=100
EVAL_EPISODES=50
LEARN_AFTER=256
UPDATES_PER_CHUNK=1
HIDDEN=512,512,512
NUM_CRITICS=10
BATCH_SIZE=256
DISCOUNT=0.99
LR=3e-4
TEMPERATURE_INIT=0.1
SEED=0
FINAL_EVAL_EPISODES=200
