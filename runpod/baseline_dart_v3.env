# The DART v3 policy (step 20000) on the scene it was trained on, run on the pod that trained it
# once runpod/dart_v3.env has finished. Launched with:
#   ENV_FILE=runpod/baseline_dart_v3.env ./runpod/bootstrap.sh <ssh_host> <ssh_port>
# Runs runpod/baseline.sh in the pod's `train` tmux session against the checkpoint already on the
# pod; its log is ${OUT_DIR}/baseline.log. Nothing is pulled from or pushed to the Hub but the
# SmolVLA backbone.
LAUNCH=baseline
SYNC_REPO=1
POD_REPO=/workspace/vla_chess
HUB_PUSH=false
POLICY_IN=/workspace/outputs/smolvla_chess_dart_v3/checkpoints/020000/pretrained_model
OUT_DIR=/workspace/baseline/dart_v3
WORKERS=4
SWEEP_ROLLOUTS=1000
HELDOUT_MOVES=d6:d5,e5:e4
HELDOUT_ROLLOUTS=200
EVAL_ROLLOUTS=1000
DART_OUT=
