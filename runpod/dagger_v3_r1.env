# DAgger round 1 on the stiff-contact scene, from the DART v3 policy (step 20000), launched with:
#   ssh -p <ssh_port> root@<ssh_host> mkdir -p /workspace/dagger_v3/round1
#   rsync -a -e "ssh -p <ssh_port>" ~/data/vla_chess/baseline/dart_v3/rollouts \
#     root@<ssh_host>:/workspace/dagger_v3/round1/
#   rsync -a -e "ssh -p <ssh_port>" ~/data/vla_chess/baseline/dart_v3/sweep-trained.json \
#     root@<ssh_host>:/workspace/dagger_v3/round1/rollouts.json
#   ENV_FILE=runpod/dagger_v3_r1.env ./runpod/bootstrap.sh <ssh_host> <ssh_port>
# The policy's baseline sweep is the round's step 1 (1000 state-recorded rollouts over the trained
# one-step moves), so it is uploaded first and the round starts at the takeovers. The training
# set is DART v3 and this round's takeovers only; nothing recorded on the earlier contact model.
#
# Targets the carry overshoot: more than half of the lifted-but-not-placed rollouts pass within
# 10 mm of the target at ~28 mm up and set the pawn down a square further on. Takeovers start
# from held frames, those just before a release first; rollouts that never held the pawn, most
# of them, fall through to random frames and cover the approach and grasp.
LAUNCH=dagger
SYNC_REPO=1
POD_REPO=/workspace/vla_chess
HUB_PUSH=false
DATASET_LOCAL=${HOME}/data/vla_chess/chess_pawns_funnel_dart_v3
DATASET_ROOT=/workspace/data/chess_pawns_funnel_dart_v3
POLICY_LOCAL=${HOME}/data/vla_chess/outputs/smolvla_chess_dart_v3/checkpoints/020000/pretrained_model
POLICY_IN=/workspace/policies/smolvla_chess_dart_v3_020000
BASE_DATASETS=/workspace/data/chess_pawns_funnel_dart_v3
ROUND_DIR=/workspace/dagger_v3/round1
DATASET_REPO_ID=hugginggeorge/chess-pawns-dagger-v3-r1
POLICY_REPO_ID=hugginggeorge/smolvla-chess-dagger-v3-r1
ROLLOUTS=1000
PER_ROLLOUT=1
FRAME_ORDER=carry
CARRY_LEAD=45
CARRY_PER_TIER=3
STEPS=10000
SAVE_FREQ=2000
BATCH_SIZE=32
EVAL_ROLLOUTS=1000
SWEEP_ROLLOUTS=1000
