# DAgger v3 round 1's fine-tune again at 5000 steps instead of 10000, on the same merged dataset and
# from the same DART v3 policy, evaluated on 200 rollouts each. Launched with:
#   ssh -p <ssh_port> root@<ssh_host> mkdir -p /workspace/dagger_v3/round1_5k/takeovers
#   rsync -a -e "ssh -p <ssh_port>" ~/data/vla_chess/dagger_v3/round1/rollouts.json \
#     root@<ssh_host>:/workspace/dagger_v3/round1_5k/
#   rsync -a -e "ssh -p <ssh_port>" ~/data/vla_chess/dagger_v3/round1/takeovers/meta \
#     root@<ssh_host>:/workspace/dagger_v3/round1_5k/takeovers/
#   ENV_FILE=runpod/dagger_v3_r1_5k.env ./runpod/bootstrap.sh <ssh_host> <ssh_port>
# The round's rollouts.json and the takeovers' meta mark steps 1 and 2 done, and the merged dataset
# is uploaded straight into the round's train-dataset, so the round starts at the fine-tune.
#
# Compares against round 1's 10000-step policy: d7->d6 placement 23.4%, sweep placement 10.5%,
# both on 1000 rollouts. The cosine schedule rescales to STEPS, so this decays fully by step 5000.
LAUNCH=dagger
SYNC_REPO=1
POD_REPO=/workspace/vla_chess
HUB_PUSH=false
DATASET_LOCAL=${HOME}/data/vla_chess/dagger_v3/round1/train-dataset
DATASET_ROOT=/workspace/dagger_v3/round1_5k/train-dataset
POLICY_LOCAL=${HOME}/data/vla_chess/outputs/smolvla_chess_dart_v3/checkpoints/020000/pretrained_model
POLICY_IN=/workspace/policies/smolvla_chess_dart_v3_020000
BASE_DATASETS=/workspace/dagger_v3/round1_5k/train-dataset
ROUND_DIR=/workspace/dagger_v3/round1_5k
DATASET_REPO_ID=hugginggeorge/chess-pawns-dagger-v3-r1
POLICY_REPO_ID=hugginggeorge/smolvla-chess-dagger-v3-r1-5k
FRAME_ORDER=carry
STEPS=5000
SAVE_FREQ=1000
BATCH_SIZE=32
EVAL_ROLLOUTS=200
SWEEP_ROLLOUTS=200
