# DAgger round 2 from the round 1 policy (step 10000), launched with:
#   ENV_FILE=runpod/dagger_r2.env ./runpod/bootstrap.sh <ssh_host> <ssh_port>
# Uploads the round 1 training set (DART v2 + round 1 takeovers) and checkpoint from this
# machine, then runs runpod/dagger_round.sh in the pod's `train` tmux session; its log is
# ${ROUND_DIR}/round.log. Takeovers start from frames carrying the pawn, those just before a
# mid-air release first, three of each before any other frame.
LAUNCH=dagger
SYNC_REPO=1
POD_REPO=/workspace/vla_chess
HUB_PUSH=false
DATASET_LOCAL=${HOME}/data/vla_chess/chess_pawns_dagger_r1
DATASET_ROOT=/workspace/data/chess_pawns_dagger_r1
POLICY_LOCAL=${HOME}/data/vla_chess/dagger/round1/train/checkpoints/010000/pretrained_model
POLICY_IN=/workspace/policies/smolvla_chess_dagger_r1_010000
BASE_DATASETS=/workspace/data/chess_pawns_dagger_r1
ROUND_DIR=/workspace/dagger/round2
DATASET_REPO_ID=hugginggeorge/chess-pawns-dagger-r2
POLICY_REPO_ID=hugginggeorge/smolvla-chess-dagger-r2
ROLLOUTS=200
PER_ROLLOUT=2
FRAME_ORDER=carry
CARRY_LEAD=45
CARRY_PER_TIER=3
STEPS=10000
SAVE_FREQ=2000
BATCH_SIZE=32
EVAL_ROLLOUTS=1000
