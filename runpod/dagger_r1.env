# DAgger round 1 from the DART v2 policy (step 20000), launched with:
#   ENV_FILE=runpod/dagger_r1.env ./runpod/bootstrap.sh <ssh_host> <ssh_port>
# Uploads the DART v2 dataset and checkpoint from this machine, then runs runpod/dagger_round.sh
# in the pod's `train` tmux session; its log is ${ROUND_DIR}/round.log.
LAUNCH=dagger
SYNC_REPO=1
POD_REPO=/workspace/vla_chess
HUB_PUSH=false
DATASET_LOCAL=${HOME}/data/vla_chess/chess_pawns_funnel_dart_v2
DATASET_ROOT=/workspace/data/chess_pawns_funnel_dart_v2
POLICY_LOCAL=${HOME}/data/vla_chess/outputs/smolvla_chess_dart_v2/checkpoints/020000/pretrained_model
POLICY_IN=/workspace/policies/smolvla_chess_dart_v2_020000
BASE_DATASETS=/workspace/data/chess_pawns_funnel_dart_v2
ROUND_DIR=/workspace/dagger/round1
DATASET_REPO_ID=hugginggeorge/chess-pawns-dagger-r1
POLICY_REPO_ID=hugginggeorge/smolvla-chess-dagger-r1
ROLLOUTS=200
PER_ROLLOUT=2
FRAME_ORDER=random
STEPS=10000
SAVE_FREQ=2000
BATCH_SIZE=32
EVAL_ROLLOUTS=1000
