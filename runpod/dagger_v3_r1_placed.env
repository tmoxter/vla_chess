# A DAgger round from the round 1 policy (step 10000) whose takeovers start only after the pawn
# was placed: the expert backs off, flies home and holds still at rest for a second. It reuses the
# 1000 rollouts of the round 1 policy recorded for round 2, so step 1 is skipped; upload them
# before bootstrapping:
#   ssh -p <ssh_port> root@<ssh_host> mkdir -p /workspace/dagger_v3/round1_placed
#   rsync -a -e "ssh -p <ssh_port>" ~/data/vla_chess/dagger_v3/round2/rollouts \
#     ~/data/vla_chess/dagger_v3/round2/rollouts.json root@<ssh_host>:/workspace/dagger_v3/round1_placed/
# then launch with:
#   ENV_FILE=runpod/dagger_v3_r1_placed.env ./runpod/bootstrap.sh <ssh_host> <ssh_port>
# Uploads the round 1 training set (DART v3 + round 1 takeovers) and checkpoint, then runs
# runpod/dagger_round.sh in the pod's `train` tmux session; its log is ${ROUND_DIR}/round.log.
# The round 1 policy is scored on d7->d6 by the same eval build at the end, so the
# placement-at-done rates of both policies come from one harness.
LAUNCH=dagger
SYNC_REPO=1
POD_REPO=/workspace/vla_chess
HUB_PUSH=false
DATASET_LOCAL=${HOME}/data/vla_chess/dagger_v3/round1/train-dataset
DATASET_ROOT=/workspace/data/chess_pawns_dagger_v3_r1
POLICY_LOCAL=${HOME}/data/vla_chess/dagger_v3/round1/train/checkpoints/010000/pretrained_model
POLICY_IN=/workspace/policies/smolvla_chess_dagger_v3_r1_010000
BASE_DATASETS=/workspace/data/chess_pawns_dagger_v3_r1
ROUND_DIR=/workspace/dagger_v3/round1_placed
DATASET_REPO_ID=hugginggeorge/chess-pawns-dagger-v3-r1-placed
POLICY_REPO_ID=hugginggeorge/smolvla-chess-dagger-v3-r1-placed
ROLLOUTS=1000
PER_ROLLOUT=3
MAX_ATTEMPTS=8
FRAME_ORDER=placed
REST_HOLD=1.0
STEPS=10000
SAVE_FREQ=2000
BATCH_SIZE=32
EVAL_ROLLOUTS=200
SWEEP_ROLLOUTS=200
BASELINE_ROLLOUTS=200
