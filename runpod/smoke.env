# Smoke test — a deliberately tiny, cheap end-to-end run that proves the pod PLUMBING before the
# real Exp-2 harvest commits GPU hours to it. It exercises every seam: EGL datagen render on the
# pod -> LeRobot v3.0 serialize -> Hub push + v3.0 tag -> training pulls that dataset -> single-cam
# rename_map -> checkpoint save + push to the Hub -> /workspace disk survives it. It is NOT meant to
# learn anything.
#
#   DATAGEN=1 ENV_FILE=runpod/smoke.env ./runpod/bootstrap.sh <ssh_host> <ssh_port>
#
# Success = the dataset repo gains a v3.0 tag AND a checkpoint appears under the policy repo. Then
# tear the pod down and launch the real run with exp2.env.

# --- Datagen (pod-side, EGL GPU render) ---------------------------------------------------------
# The fingers-down baseline: the plain vertical single-pawn push on the centre files (c/d/e/f), a
# handful of episodes at 10 fps. No funnel, no tilt — the simplest thing that still flows a real
# dataset through the whole pipe.
DATASET_REPO_ID=hugginggeorge/chess-smoke-v1
DATAGEN_ARGS="--single-pawn --episodes 8 --fps 10 --out /workspace/data/chess_smoke --repo-id ${DATASET_REPO_ID} --push"

# --- Training -----------------------------------------------------------------------------------
# A few hundred steps, checkpoint early so the Hub-push seam fires fast; everything on /workspace.
POLICY_REPO_ID=hugginggeorge/smolvla-chess-smoke
BATCH_SIZE=8
STEPS=200
SAVE_FREQ=100
OUTPUT_DIR=/workspace/outputs/smolvla_chess_smoke
METRICS_DIR=/workspace/outputs/smolvla_chess_smoke
JOB_NAME=smolvla_chess_smoke
