# The round 3 DAgger policy (step 10000) on the scene with stiff jaw contacts, the gripper at its
# torque limit and friction 0.4, then the DART funnel dataset regenerated on that scene. Launched
# with:
#   ENV_FILE=runpod/baseline_r3.env ./runpod/bootstrap.sh <ssh_host> <ssh_port>
# Uploads the checkpoint from this machine and runs runpod/baseline.sh in the pod's `train` tmux
# session; its log is ${OUT_DIR}/baseline.log. Nothing is pulled from or pushed to the Hub but
# the SmolVLA backbone.
LAUNCH=baseline
SYNC_REPO=1
POD_REPO=/workspace/vla_chess
HUB_PUSH=false
POLICY_LOCAL=${HOME}/data/vla_chess/dagger/round3/train/checkpoints/010000/pretrained_model
POLICY_IN=/workspace/policies/smolvla_chess_dagger_r3_010000
OUT_DIR=/workspace/baseline/round3
WORKERS=4
SWEEP_ROLLOUTS=1000
HELDOUT_MOVES=d6:d5,e5:e4
HELDOUT_ROLLOUTS=200
EVAL_ROLLOUTS=1000
DART_OUT=/workspace/data/chess_pawns_funnel_dart_v3
DART_REPO_ID=hugginggeorge/chess-pawns-funnel-dart-v3
