# DAgger v3 round 2's fine-tune again at 20000 steps instead of 10000, on the same merged dataset and
# from the same round 1 policy, evaluated on 200 rollouts each. Launched with:
#   ssh -p <ssh_port> root@<ssh_host> mkdir -p /workspace/dagger_v3/round2_20k/takeovers
#   rsync -a -e "ssh -p <ssh_port>" ~/data/vla_chess/dagger_v3/round2/rollouts.json \
#     root@<ssh_host>:/workspace/dagger_v3/round2_20k/
#   rsync -a -e "ssh -p <ssh_port>" ~/data/vla_chess/dagger_v3/round2/takeovers/meta \
#     root@<ssh_host>:/workspace/dagger_v3/round2_20k/takeovers/
#   ENV_FILE=runpod/dagger_v3_r2_20k.env ./runpod/bootstrap.sh <ssh_host> <ssh_port>
# The round's rollouts.json and the takeovers' meta mark steps 1 and 2 done, and the merged dataset
# is uploaded straight into the round's train-dataset, so the round starts at the fine-tune.
#
# Compares against round 2's 10000-step policy: d7->d6 grasp 38.0%, placement 23.0%; sweep grasp
# 29.0%, placement 8.5%, all on 200 rollouts. The merged set holds 817481 frames, so 20000 steps at
# batch 32 pass over it about 0.78 times, against 0.39 at 10000.
LAUNCH=dagger
SYNC_REPO=1
POD_REPO=/workspace/vla_chess
HUB_PUSH=false
DATASET_LOCAL=${HOME}/data/vla_chess/dagger_v3/round2/train-dataset
DATASET_ROOT=/workspace/dagger_v3/round2_20k/train-dataset
POLICY_LOCAL=${HOME}/data/vla_chess/dagger_v3/round1/train/checkpoints/010000/pretrained_model
POLICY_IN=/workspace/policies/smolvla_chess_dagger_v3_r1_010000
BASE_DATASETS=/workspace/dagger_v3/round2_20k/train-dataset
ROUND_DIR=/workspace/dagger_v3/round2_20k
DATASET_REPO_ID=hugginggeorge/chess-pawns-dagger-v3-r2
POLICY_REPO_ID=hugginggeorge/smolvla-chess-dagger-v3-r2-20k
FRAME_ORDER=carry
STEPS=20000
SAVE_FREQ=4000
BATCH_SIZE=32
EVAL_ROLLOUTS=200
SWEEP_ROLLOUTS=200
