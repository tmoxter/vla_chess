# DART v2 training: SmolVLA fine-tuned on the funnel recipe recorded under action noise on every
# leg (runpod/dart_datagen.sh), with the leg tracker's roll hold in force. Training knobs match the
# DART v1 and Exp-2 runs (batch 32, 20k steps, checkpoints every 2k) so the three compare directly.
# The dataset is generated off-pod and uploaded, so nothing is pulled from or pushed to the Hub.
#
#   DATASET_LOCAL=~/data/vla_chess/chess_pawns_funnel_dart_v2 ENV_FILE=runpod/dart_v2.env \
#     ./runpod/bootstrap.sh <ssh_host> <ssh_port>

DATASET_REPO_ID=hugginggeorge/chess-pawns-funnel-dart-v2
DATASET_ROOT=/workspace/data/chess_pawns_funnel_dart_v2
POLICY_REPO_ID=hugginggeorge/smolvla-chess-dart-v2
HUB_PUSH=false
BATCH_SIZE=32
STEPS=20000
SAVE_FREQ=2000
OUTPUT_DIR=/workspace/outputs/smolvla_chess_dart_v2
# Must sit outside OUTPUT_DIR: lerobot-train aborts if OUTPUT_DIR already exists.
METRICS_DIR=/workspace/outputs/smolvla_chess_dart_v2_logs
JOB_NAME=smolvla_chess_dart_v2
# The repo goes on the persistent volume too, for the eval harness after training.
SYNC_REPO=1
POD_REPO=/workspace/vla_chess
