# DAgger round 3 from the round 2 policy (step 10000), launched with:
#   ENV_FILE=runpod/dagger_r3.env ./runpod/bootstrap.sh <ssh_host> <ssh_port>
# Uploads the round 2 training set (DART v2 + round 1 and 2 takeovers) and checkpoint from this
# machine, then runs runpod/dagger_round.sh in the pod's `train` tmux session; its log is
# ${ROUND_DIR}/round.log.
#
# Targets one failure: the jaws opened on the pawn higher than takeover.HIGH_RELEASE (6 mm) above
# the board. Takeovers start only from the last RELEASE_LEAD held frames before such an opening,
# and a recovery that itself lets go above 6 mm is not kept. About 5% of rollouts open that high,
# so the round rolls out 1000 and keeps up to 4 takeovers from each. The measure is
# opened_mid_air_rate over the trained one-step moves: step 1's rollouts (this policy) against
# step 6's sweep (the trained one), on the same moves and count.
LAUNCH=dagger
SYNC_REPO=1
POD_REPO=/workspace/vla_chess
HUB_PUSH=false
DATASET_LOCAL=${HOME}/data/vla_chess/chess_pawns_dagger_r2
DATASET_ROOT=/workspace/data/chess_pawns_dagger_r2
POLICY_LOCAL=${HOME}/data/vla_chess/dagger/round2/train/checkpoints/010000/pretrained_model
POLICY_IN=/workspace/policies/smolvla_chess_dagger_r2_010000
BASE_DATASETS=/workspace/data/chess_pawns_dagger_r2
ROUND_DIR=/workspace/dagger/round3
DATASET_REPO_ID=hugginggeorge/chess-pawns-dagger-r3
POLICY_REPO_ID=hugginggeorge/smolvla-chess-dagger-r3
ROLLOUTS=1000
WORKERS=8
PER_ROLLOUT=4
FRAME_ORDER=release
RELEASE_LEAD=30
STEPS=10000
SAVE_FREQ=2000
BATCH_SIZE=32
EVAL_ROLLOUTS=1000
SWEEP_ROLLOUTS=1000
