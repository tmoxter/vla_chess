# DART v3 training: SmolVLA fine-tuned on the funnel recipe recorded under action noise on every
# leg (runpod/dart_datagen.sh), on the scene with stiff jaw contacts, friction 0.4 and the gripper
# servo at half its torque. Training knobs match DART v2 (batch 32, 20k steps, checkpoints every
# 2k) so the two compare directly.
# The dataset is generated off-pod and uploaded, so nothing is pulled from or pushed to the Hub.
#
#   DATASET_LOCAL=~/data/vla_chess/chess_pawns_funnel_dart_v3 ENV_FILE=runpod/dart_v3.env \
#     ./runpod/bootstrap.sh <ssh_host> <ssh_port>

DATASET_REPO_ID=hugginggeorge/chess-pawns-funnel-dart-v3
DATASET_ROOT=/workspace/data/chess_pawns_funnel_dart_v3
POLICY_REPO_ID=hugginggeorge/smolvla-chess-dart-v3
HUB_PUSH=false
BATCH_SIZE=32
STEPS=20000
SAVE_FREQ=2000
OUTPUT_DIR=/workspace/outputs/smolvla_chess_dart_v3
# Must sit outside OUTPUT_DIR: lerobot-train aborts if OUTPUT_DIR already exists.
METRICS_DIR=/workspace/outputs/smolvla_chess_dart_v3_logs
JOB_NAME=smolvla_chess_dart_v3
# The repo goes on the persistent volume too, for the eval harness after training.
SYNC_REPO=1
POD_REPO=/workspace/vla_chess
