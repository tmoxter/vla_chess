# Experiment 2 — first fine-tune overrides, sourced by bootstrap.sh (and datagen.sh / train.sh).
# These only override; train.sh keeps its Exp-1 overfit defaults when this file is not sourced, so
# nothing here clobbers the Exp-1 setup. See experiment-2-plan.md.
#
#   DATAGEN=1 ENV_FILE=runpod/exp2.env ./runpod/bootstrap.sh <ssh_host> <ssh_port>

# --- Datagen (pod-side, EGL GPU render) ---------------------------------------------------------
# The real first fine-tune: the tilted-grasp sampling funnel, restricted to one-step pushes under a
# single constant label, harvested at 30 fps. Pushed private, tagged v3.0 for training to resolve.
DATASET_REPO_ID=hugginggeorge/chess-pawns-funnel-v1
DATAGEN_ARGS="--funnel --one-step-only --single-task --seeds 6 --fps 30 --out /workspace/data/chess_pawns_funnel --repo-id ${DATASET_REPO_ID} --push"

# --- Training -----------------------------------------------------------------------------------
# batch 32 (L4 had headroom at 16); checkpoints + log on the persistent /workspace volume, NOT the
# root overlay that filled up in Exp 1; a fresh policy repo so the overfit run is untouched.
POLICY_REPO_ID=hugginggeorge/smolvla-chess-exp2
BATCH_SIZE=32
STEPS=20000
SAVE_FREQ=2000
OUTPUT_DIR=/workspace/outputs/smolvla_chess_exp2
METRICS_DIR=/workspace/outputs/smolvla_chess_exp2
JOB_NAME=smolvla_chess_exp2
